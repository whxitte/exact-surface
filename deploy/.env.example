# ExactSurface — copy to `.env` and fill in. `docker compose up -d` reads it from here.
#
#   cp .env.example .env
#
# Compose refuses to start if any of the required values below are missing, which is
# deliberate: a stack that boots with a blank database password is worse than one that
# does not boot.

# ── Your licence ────────────────────────────────────────────────────────────────
# The token we sent you, on ONE line. Paste it here rather than exporting it in a
# shell: an exported variable lasts one terminal session, and the next `docker compose
# up` without it drops the instance to read-only.
#
# Confirm it took after starting:  docker compose logs api | grep "license active"
EXACTSURFACE_LICENSE=

# ── What to run ─────────────────────────────────────────────────────────────────
# The version you were shipped. Change it only when you intend to upgrade, then
# `docker compose pull && docker compose up -d`.
EXACTSURFACE_VERSION=1.0.0
EXACTSURFACE_REGISTRY=ghcr.io/whxitte

# ── Your host ───────────────────────────────────────────────────────────────────
# The domain this instance is served on. Point an A record at this server BEFORE
# starting, or the automatic TLS certificate cannot be issued.
DOMAIN=

# ── Datastore credentials (REQUIRED — no defaults, by design) ───────────────────
# Neither service is reachable from outside the compose network, but these still
# matter: they are what stops one compromised container from reading every finding.
# Generate them, do not invent them:  openssl rand -base64 32
MONGO_ROOT_USER=exactsurface
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ── Application secrets (REQUIRED) ──────────────────────────────────────────────
# JWT_SECRET signs your users' sessions. SECRET_HASH_KEY is what lets the platform
# recognise a leaked credential it has seen before without ever storing the credential
# itself. Both must be random and neither can be rotated without consequence:
# changing JWT_SECRET logs everyone out; changing SECRET_HASH_KEY makes previously
# reported secret findings look new.
#   openssl rand -base64 48
EXACTSURFACE_JWT_SECRET=
EXACTSURFACE_SECRET_HASH_KEY=

# ── Scanning politeness ─────────────────────────────────────────────────────────
# The per-target ceiling, in requests/packets per second. This is the single most
# important operational setting in the product: it is what keeps a scan from looking
# like an attack to your own monitoring. Raise it only for infrastructure you operate
# and have capacity for.
EXACTSURFACE_GLOBAL_RATE_PER_TARGET=10
EXACTSURFACE_SCAN_COOLOFF_SECONDS=2

# MUST equal the `replicas:` count of the worker service in docker-compose.yml.
# If Redis is unreachable each worker enforces 1/this of the cap on its own, so a
# value below the real replica count lets a degraded fleet scan over the ceiling.
EXACTSURFACE_WORKER_FLEET_SIZE=3
EXACTSURFACE_WORKER_CONCURRENCY=4
EXACTSURFACE_TOOL_DEFAULT_TIMEOUT=300

# ── Retention ───────────────────────────────────────────────────────────────────
# How long each class of data is kept. Raw secret material is deliberately the
# shortest: it is the most sensitive thing the platform ever holds.
EXACTSURFACE_RETENTION_FINDINGS_DAYS=730
EXACTSURFACE_RETENTION_RAW_SCAN_DAYS=90
EXACTSURFACE_RETENTION_RAW_SECRET_DAYS=30

# ── Email (optional) ────────────────────────────────────────────────────────────
# `log` writes verification and alert mail to the container log instead of sending it,
# which is fine for a single-operator install. Set `smtp` and the SMTP_* values below
# if you want real email — required if you turn on email verification.
EXACTSURFACE_EMAIL_TRANSPORT=log
EXACTSURFACE_APP_BASE_URL=https://your-domain.example
EXACTSURFACE_REQUIRE_EMAIL_VERIFICATION=false
# EXACTSURFACE_SMTP_HOST=
# EXACTSURFACE_SMTP_PORT=587
# EXACTSURFACE_SMTP_USER=
# EXACTSURFACE_SMTP_PASSWORD=
# EXACTSURFACE_SMTP_FROM=exactsurface@your-domain.example

# ── Cloud asset inventory (optional) ────────────────────────────────────────────
# Path INSIDE the container to a cloudlist provider config holding READ-ONLY keys for
# your own cloud accounts. Mount it in a compose override. The keys never leave your
# infrastructure — see docs/CLIENT_GUIDE.md §5.9.
# EXACTSURFACE_CLOUDLIST_CONFIG=/run/secrets/cloudlist.yaml
