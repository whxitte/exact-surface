# Vantari configuration. Copy to .env and fill in. All vars are VANTARI_-prefixed.
# Secrets must NEVER be committed. .env is gitignored.

# -- environment --
VANTARI_ENV=dev                 # dev | staging | prod
VANTARI_DEBUG=true

# -- datastore (self-hosted MongoDB by default — free; Atlas is optional) --
VANTARI_MONGO_URI=mongodb://localhost:27017
VANTARI_MONGO_DB=vantari

# -- redis (task queue + politeness rate-limit buckets) --
VANTARI_REDIS_URI=redis://localhost:6379/0

# -- auth / crypto (CHANGE THESE IN PROD — startup refuses insecure defaults) --
VANTARI_JWT_SECRET=dev-insecure-change-me
VANTARI_JWT_ALGORITHM=HS256
VANTARI_JWT_TTL_SECONDS=3600
VANTARI_SECRET_HASH_KEY=dev-insecure-secret-hash-key

# -- scanning politeness / compliance (§3.8b) --
VANTARI_GLOBAL_RATE_PER_TARGET=10     # max packets/requests per second per target IP
VANTARI_SCAN_COOLOFF_SECONDS=2
VANTARI_MASSCAN_ENABLED=false         # hard-off in v1 (ADR-0004)
# DEV ONLY — allow scanning RFC1918 private IPs (e.g. a local lab VM). Refused in prod.
VANTARI_LAB_ALLOW_PRIVATE=false

# -- retention (days) --
VANTARI_RETENTION_FINDINGS_DAYS=730
VANTARI_RETENTION_RAW_SCAN_DAYS=90
VANTARI_RETENTION_RAW_SECRET_DAYS=30

# -- worker --
VANTARI_WORKER_CONCURRENCY=4
VANTARI_TOOL_DEFAULT_TIMEOUT=300

# -- external API keys (optional; features degrade gracefully if unset) --
# VANTARI_SHODAN_API_KEY=
# VANTARI_CENSYS_API_ID=
# VANTARI_CENSYS_API_SECRET=
# VANTARI_GITHUB_TOKEN=
# VANTARI_GOOGLE_CSE_KEY=
# VANTARI_GOOGLE_CSE_CX=
# VANTARI_BRAVE_API_KEY=
# VANTARI_SERPAPI_KEY=

# -- transactional email (signup verification) --
# "log" (default) prints the verification link to the log — no account needed, ideal
# for local dev. Switch to "smtp" and fill the creds below to send real mail. Any
# provider works (they all speak SMTP): Resend (3k/mo free), Brevo (300/day free),
# Amazon SES ($0.10/1k), Postmark, Mailgun.
VANTARI_EMAIL_TRANSPORT=log
# VANTARI_EMAIL_FROM=Vantari <no-reply@yourdomain.com>
# Public URL of the frontend — verification links are built from it.
VANTARI_APP_BASE_URL=http://localhost:3000
# Require a verified email before a program can be created. Off in dev, ON in prod.
VANTARI_REQUIRE_EMAIL_VERIFICATION=false
# -- SMTP (only when VANTARI_EMAIL_TRANSPORT=smtp) --
# Resend:  smtp.resend.com : 587   user=resend           pass=<api key>
# Brevo:   smtp-relay.brevo.com : 587
# SES:     email-smtp.<region>.amazonaws.com : 587
# VANTARI_SMTP_HOST=
# VANTARI_SMTP_PORT=587
# VANTARI_SMTP_USER=
# VANTARI_SMTP_PASSWORD=
# VANTARI_SMTP_STARTTLS=true
