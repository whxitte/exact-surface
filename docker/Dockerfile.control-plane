# ExactSurface control plane (VENDOR-HOSTED ONLY — never shipped to a customer).
#
# This is the tiny service the vendor runs: it renews subscription licences and
# serves the licence-gated update manifest. It holds the Ed25519 PRIVATE key, which
# is why it must never be published to a public registry or handed to a customer.
FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Only what the control plane actually needs — it does no scanning and touches no
# database, so the heavy recon/runtime deps are deliberately absent.
RUN pip install --no-cache-dir \
        "fastapi>=0.110" "uvicorn[standard]>=0.27" \
        "pydantic>=2.6" "pydantic-settings>=2.2" "cryptography>=42"

COPY core/ core/
COPY control_plane/ control_plane/

RUN useradd -m -u 10003 controlplane && chown -R controlplane:controlplane /app
USER controlplane

EXPOSE 8800
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8800/healthz || exit 1

CMD ["uvicorn", "control_plane.server:app", "--host", "0.0.0.0", "--port", "8800"]
