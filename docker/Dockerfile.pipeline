# Vantari pipeline image: all recon tooling + Python runtime + app code.
# Reused (with different commands) by the daemon, scheduler, and workers.
# masscan is installed but DISABLED at the application layer in v1 (ADR-0004).

# ---- stage 1: build Go-based tooling --------------------------------------
# Go 1.24+ is required by recent ProjectDiscovery releases (e.g. subfinder 2.14).
# GOTOOLCHAIN=auto lets `go install` fetch an even newer toolchain if a tool needs it.
FROM golang:1.24-bookworm AS gotools
ENV GOBIN=/tools GOFLAGS=-buildvcs=false GOTOOLCHAIN=auto
RUN apt-get update && apt-get install -y --no-install-recommends libpcap-dev && rm -rf /var/lib/apt/lists/*
# ProjectDiscovery suite (JSON-native, rate-limit-aware) + companions.
RUN go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest && \
    go install github.com/projectdiscovery/httpx/cmd/httpx@latest && \
    go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest && \
    go install github.com/projectdiscovery/katana/cmd/katana@latest && \
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest && \
    go install github.com/projectdiscovery/tlsx/cmd/tlsx@latest && \
    go install github.com/projectdiscovery/asnmap/cmd/asnmap@latest && \
    go install github.com/projectdiscovery/cloudlist/cmd/cloudlist@latest && \
    go install github.com/projectdiscovery/uncover/cmd/uncover@latest && \
    go install github.com/projectdiscovery/notify/cmd/notify@latest && \
    go install github.com/projectdiscovery/alterx/cmd/alterx@latest && \
    go install github.com/ffuf/ffuf/v2@latest && \
    go install github.com/lc/gau/v2/cmd/gau@latest && \
    go install github.com/tomnomnom/waybackurls@latest
# NOTE: gitleaks is intentionally NOT installed — secret detection is regex-based
# (core/secrets_policy.py), it does not shell out to the gitleaks binary. (Its
# module path also mismatches its repo, breaking `go install @latest`.)

# ---- stage 2: runtime ------------------------------------------------------
FROM python:3.11-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/tools:${PATH}"

# nmap + masscan + libpcap runtime + feroxbuster (prebuilt).
# System packages: nmap, masscan, libpcap, curl.
RUN apt-get update && apt-get install -y --no-install-recommends \
        nmap masscan libpcap0.8 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# feroxbuster (content discovery). Arch-aware AND non-fatal: if the arch's asset
# is unavailable (e.g. no arm64 build), the image still builds — ffuf (installed
# via Go above) covers content-discovery fuzzing. `curl -f` fails on 404 rather
# than piping an HTML error page into tar.
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
         amd64) FB=x86_64-linux-feroxbuster.tar.gz ;; \
         arm64) FB=aarch64-linux-feroxbuster.tar.gz ;; \
         *) FB="" ;; \
       esac \
    && if [ -n "$FB" ] && curl -fsSL \
         "https://github.com/epi052/feroxbuster/releases/latest/download/$FB" \
         -o /tmp/ferox.tar.gz; then \
         tar -xzf /tmp/ferox.tar.gz -C /usr/local/bin feroxbuster \
         && rm -f /tmp/ferox.tar.gz \
         && echo "feroxbuster installed for $ARCH"; \
       else \
         echo "WARN: feroxbuster unavailable for $ARCH; content discovery will use ffuf only"; \
       fi

COPY --from=gotools /tools/ /tools/

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-fetch nuclei templates at build time (pinned/updated by nuclei_watch later).
RUN nuclei -update-templates -silent || true

COPY core/ core/
COPY db/ db/
COPY modules/ modules/
COPY taskqueue/ taskqueue/
COPY daemon/ daemon/
COPY api/ api/

# Non-root: scanning does not need root (naabu falls back to connect-scan).
RUN useradd -m -u 10001 vantari && chown -R vantari:vantari /app
USER vantari

# Health check validates binaries + config + scope feeds (no network).
HEALTHCHECK --interval=60s --timeout=20s --retries=3 \
    CMD python -m daemon.main --dry-run || exit 1

CMD ["python", "-m", "daemon.main"]
