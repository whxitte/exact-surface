# ExactSurface API image — slim; the API never runs scan tools, so no recon binaries.
FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
# curl for the healthcheck; the rest are WeasyPrint's native deps (pango/cairo/
# gdk-pixbuf/ffi + fonts) so PDF report export works instead of returning 501.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
        libffi8 shared-mime-info fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ core/
COPY db/ db/
COPY modules/ modules/
COPY pipelines/ pipelines/
COPY taskqueue/ taskqueue/
COPY daemon/ daemon/
COPY api/ api/
COPY scripts/ scripts/

RUN useradd -m -u 10002 exactsurface && chown -R exactsurface:exactsurface /app
USER exactsurface

# Vendor build stamps (§ commercial). BUILD_ID watermarks responses + exported
# reports; LICENSE_PUBLIC_KEY is the Ed25519 verify-only key licenses are checked
# against — safe to ship (it cannot mint). Both are injected by the release
# workflow; a local build leaves them at the dev defaults.
ARG BUILD_ID=dev
ARG LICENSE_PUBLIC_KEY=""
ENV EXACTSURFACE_BUILD_ID=${BUILD_ID} \
    EXACTSURFACE_LICENSE_PUBLIC_KEY=${LICENSE_PUBLIC_KEY}

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
